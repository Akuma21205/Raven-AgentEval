# Environment variables for AgentEval
# Copy this file to .env and fill in your values.

# ── Database ───────────────────────────────────────────────────────────────────
# Default local development uses SQLite (zero setup required):
DATABASE_URL=sqlite:///./agenteval.db

# For PostgreSQL / Docker deployments (uncomment and provide your credentials):
# POSTGRES_USER=your_postgres_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=your_database_name
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database_name>

# ── LLM API Keys ───────────────────────────────────────────────────────────────
# Required for TaskSuccessEvaluator (NVIDIA Nemotron judge)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Optional: OpenAI (if using OpenAI-based judge in future) ──────────────────
# OPENAI_API_KEY=your_openai_api_key_here
